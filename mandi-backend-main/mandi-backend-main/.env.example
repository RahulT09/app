# Copy this file to .env and fill in your real values.
# Never commit the .env file to version control.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>

# JWT signing secret (64+ chars)
JWT_SECRET=replace_with_a_long_random_secret

# Email (Gmail App Password or Resend/Brevo in production)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Razorpay (test keys for dev, live keys for production)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# URL of deployed frontend (no trailing slash)
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Set to production on Render/Railway
NODE_ENV=development
